<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.lihuu</groupId>
    <artifactId>native-metadata-maven-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>maven-plugin</packaging>

    <name>Native Metadata Maven Plugin</name>
    <description>Maven plugin for GraalVM native-image reflection metadata analysis, de-duplication, and rule-based pruning.</description>
    <url>https://github.com/lihuu/native-metadata-maven-plugin</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>lihuu</name>
            <email>lihu1449488533@outlook.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/lihuu/native-metadata-maven-plugin.git</connection>
        <developerConnection>scm:git:ssh://github.com:lihuu/native-metadata-maven-plugin.git</developerConnection>
        <url>https://github.com/lihuu/native-metadata-maven-plugin</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <jackson.version>2.18.3</jackson.version>
        <junit.version>5.12.0</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.1</version>
                <configuration>
                    <goalPrefix>native-metadata</goalPrefix>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.8</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.8</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          The profile that produces what Maven Central accepts, and nothing more.

          Activate it with -Pcentral (scripts/publish-central.sh does). It is deliberately not called
          "release": a release in this repository is a git tag cut by scripts/release.sh, and a
          profile that sounds like the same thing is a profile someone activates expecting a tag.
          Building and publishing are two steps, and only the second one is permanent.
        -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <!-- Central refuses a bundle that has a jar without its sources and its javadoc
                         jar beside it, and there is no way to add them afterwards: the upload is the
                         whole version. Both are attached here so `mvn -Pcentral verify` is already the
                         complete artifact set. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <!-- A doc-comment lint failing a publication is a trade nobody asked
                                 for: the javadoc jar's contents are not inspected by Central, and a
                                 warning about a missing @param should not be what stops a release. -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!--
                              `gpgArguments`, not a `pinentryMode` element. This plugin has no such
                              parameter, and naming one that does not exist is silently ignored:
                              Maven prints "Parameter 'pinentryMode' is unknown for plugin" as a
                              warning and signs anyway, so a configuration that does nothing looks
                              exactly like one that works. Checked against the plugin's own
                              plugin.xml rather than against the documentation.

                              loopback is what keeps a headless run from opening a pinentry dialog
                              and hanging until it times out. It needs the key to have no
                              passphrase, or one supplied through passphraseEnvName; the key this
                              repository documents (docs/publishing.md) is generated with
                              %no-protection for exactly this reason.
                            -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                      The plugin is used for the one thing it is good at (signing, validating and
                      bundling this module into a Central-shaped tree) and NOT for uploading.

                      What it does wrong for this repository is treat its own staging directory as a
                      Maven *local repository*, so the install mechanism writes bookkeeping files
                      into the tree it is about to publish: maven-metadata-local.xml at the
                      artifactId level (a directory with no .pom in it, which Central rejects
                      outright), _remote.repositories beside each artifact, and a checksum for each
                      of those. `-Dmaven.install.skip=true` does not stop it, a dedicated
                      -Dmaven.repo.local does not stop it, and the plugin exposes no file-level
                      filter: excludeArtifacts matches whole modules. That is why
                      scripts/publish-central.sh assembles the bundle itself from target/ and uploads
                      it through the same Portal API. See docs/publishing.md.

                      autoPublish=false and waitUntil=validated are the safe half of the same
                      decision: a version on Central cannot be withdrawn, so nothing here publishes
                      unless the publish script is given its release flag.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
