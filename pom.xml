<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.lihuu</groupId>
    <artifactId>native-metadata-maven-plugin</artifactId>
    <!--
      1.1.0, not 1.0.0. 1.0.0 is published on Maven Central and is the Java 25 / Class-File API build.
      Reusing that number would mean that any project which fails to stage this build can silently
      resolve the published, incompatible artifact from central under the same coordinates - which is
      exactly what happened during verification. A new number makes "the artifact under test" and
      "the artifact a user gets by default" the same thing only when someone deliberately published it.
    -->
    <version>1.1.0</version>
    <packaging>maven-plugin</packaging>

    <name>Native Metadata Maven Plugin</name>
    <description>Maven plugin for GraalVM native-image reflection metadata analysis, de-duplication, and rule-based pruning.</description>
    <url>https://github.com/lihuu/native-metadata-maven-plugin</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>lihuu</name>
            <email>lihu1449488533@outlook.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/lihuu/native-metadata-maven-plugin.git</connection>
        <developerConnection>scm:git:ssh://github.com:lihuu/native-metadata-maven-plugin.git</developerConnection>
        <url>https://github.com/lihuu/native-metadata-maven-plugin</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          The plugin itself, and its tests, are compiled for Java 17. This is the runtime baseline
          advertised to users: the plugin runs inside the Maven JVM, and the supported Maven JVMs
          start at GraalVM/OpenJDK 17. Building the plugin is a separate concern; see the README.
        -->
        <maven.compiler.release>17</maven.compiler.release>
        <jackson.version>2.18.3</jackson.version>
        <junit.version>5.12.0</junit.version>
        <!-- Single bytecode backend: ASM. This is a plugin *runtime* dependency. -->
        <asm.version>9.11</asm.version>
        <invoker.version>3.10.1</invoker.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!--
          The scanner reads class files with ASM so that a Java 17 Maven JVM can inspect Java 21/25
          bytecode. Only the core module is needed: the scanner uses a streaming visitor, not the
          tree API (asm-tree). Do not add asm-commons/asm-util without a concrete need; every added
          runtime dependency has to stay Java 17 loadable.
        -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <!--
                      Single source of truth: maven.compiler.release=17 above. An explicit <release>
                      here previously duplicated (and contradicted) the property, which is how the
                      build kept producing Java 25 classes while the property looked configurable.
                    -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <!-- The plugin records its own version in environment.json; without this the
                         JAR manifest has no Implementation-Version to report. -->
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.1</version>
                <configuration>
                    <goalPrefix>native-metadata</goalPrefix>
                    <!--
                      Declared in the plugin descriptor. This is a courtesy to Maven, not a
                      substitute for running on a real JDK 17: Maven 3 does not reliably refuse a
                      plugin whose classes are newer than the JVM, so the compatibility matrix is
                      still what proves support.
                    -->
                    <requiredJavaVersion>17</requiredJavaVersion>
                    <requiredMavenVersion>3.9.9</requiredMavenVersion>
                </configuration>
                <dependencies>
                    <!-- Build-time only: the descriptor extractor reads mojo classes with ASM. -->
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Integration tests live in examples/, are copied to target/it, and resolve the plugin
              from target/it-repo rather than the developer's ~/.m2. The repository there contains
              exactly the artifact this run produced, so an integration test cannot silently pass
              against a stale same-coordinate JAR that happens to be in the local repository.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>${invoker.version}</version>
                <configuration>
                    <projectsDirectory>${project.basedir}/examples</projectsDirectory>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                    <settingsFile>${project.basedir}/src/it/settings.xml</settingsFile>
                    <pomIncludes>
                        <pomInclude>plain-native/pom.xml</pomInclude>
                    </pomIncludes>
                    <properties>
                        <native.metadata.version>${project.version}</native.metadata.version>
                    </properties>
                    <streamLogs>true</streamLogs>
                    <showErrors>true</showErrors>
                    <failIfNoTests>true</failIfNoTests>
                    <goals>
                        <goal>clean</goal>
                        <goal>package</goal>
                    </goals>
                </configuration>
                <executions>
                    <execution>
                        <id>stage-artifact-for-invoker</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>install</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>run-invoker-it</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              The Invoker integration test proves that the sample builds and that it consumed the
              artifact this run produced. It cannot say what pruning *did*: with `clean package` and no
              verification of its own, a prune that quietly changed nothing would pass it. This step
              asserts the effect, on the Invoker clone and without a native toolchain - the changelog
              scope, the narrowed entry, the members the app reflects on, the untouched entries and the
              untouched sources. Bound to `verify` so it runs after the Invoker's integration-test run.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>assert-pruning-effect</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/examples/plain-native/verify-pruning.sh</executable>
                            <arguments>
                                <argument>--project</argument>
                                <argument>${project.build.directory}/it/plain-native</argument>
                                <argument>--source</argument>
                                <argument>${project.basedir}/examples/plain-native</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Native causality for the plain sample: baseline / pruned / missing-registration.

          These profiles are deliberately not part of the default build, and they are deliberately
          not tolerant: if native-image is missing, times out or fails, the build fails. "No native
          tool available" must never be reported as a pass.

          Usage:
            mvn -B -ntp verify -Pnative-it -DnativeImageExecutable=<absolute path>
        -->
        <profile>
            <id>native-it</id>
            <properties>
                <nativeImageExecutable>${java.home}/bin/native-image</nativeImageExecutable>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>plain-native-groups</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/examples/plain-native/verify.sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>--java-home</argument>
                                        <argument>${java.home}</argument>
                                        <argument>--maven-home</argument>
                                        <argument>${maven.home}</argument>
                                        <argument>--plugin-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--repo</argument>
                                        <argument>${project.build.directory}/it-repo</argument>
                                        <argument>--native-image</argument>
                                        <argument>${nativeImageExecutable}</argument>
                                        <argument>--evidence</argument>
                                        <argument>${project.build.directory}/compat/plain-native</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Spring Boot AOT + native + HTTP equivalence. Requires the Spring sample's dependencies to
          be resolvable and a C toolchain for the native build.

          Usage:
            mvn -B -ntp verify -Pspring-native-it -DnativeImageExecutable=<absolute path>
        -->
        <profile>
            <id>spring-native-it</id>
            <properties>
                <nativeImageExecutable>${java.home}/bin/native-image</nativeImageExecutable>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>spring-native-groups</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/examples/spring-boot-native/verify.sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>--java-home</argument>
                                        <argument>${java.home}</argument>
                                        <argument>--maven-home</argument>
                                        <argument>${maven.home}</argument>
                                        <argument>--plugin-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--repo</argument>
                                        <argument>${project.build.directory}/it-repo</argument>
                                        <argument>--evidence</argument>
                                        <argument>${project.build.directory}/compat/spring-boot-native</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          The profile that produces what Maven Central accepts, and nothing more.

          Activate it with -Pcentral (scripts/publish-central.sh does). It is deliberately not called
          "release": a release in this repository is a git tag cut by scripts/release.sh, and a
          profile that sounds like the same thing is a profile someone activates expecting a tag.
          Building and publishing are two steps, and only the second one is permanent.
        -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <!-- Central refuses a bundle that has a jar without its sources and its javadoc
                         jar beside it, and there is no way to add them afterwards: the upload is the
                         whole version. Both are attached here so `mvn -Pcentral verify` is already the
                         complete artifact set. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <!-- A doc-comment lint failing a publication is a trade nobody asked
                                 for: the javadoc jar's contents are not inspected by Central, and a
                                 warning about a missing @param should not be what stops a release. -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!--
                              `gpgArguments`, not a `pinentryMode` element. This plugin has no such
                              parameter, and naming one that does not exist is silently ignored:
                              Maven prints "Parameter 'pinentryMode' is unknown for plugin" as a
                              warning and signs anyway, so a configuration that does nothing looks
                              exactly like one that works. Checked against the plugin's own
                              plugin.xml rather than against the documentation.

                              loopback is what keeps a headless run from opening a pinentry dialog
                              and hanging until it times out. It needs the key to have no
                              passphrase, or one supplied through passphraseEnvName; the key this
                              repository documents (docs/publishing.md) is generated with
                              %no-protection for exactly this reason.
                            -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                      The plugin is used for the one thing it is good at (signing, validating and
                      bundling this module into a Central-shaped tree) and NOT for uploading.

                      What it does wrong for this repository is treat its own staging directory as a
                      Maven *local repository*, so the install mechanism writes bookkeeping files
                      into the tree it is about to publish: maven-metadata-local.xml at the
                      artifactId level (a directory with no .pom in it, which Central rejects
                      outright), _remote.repositories beside each artifact, and a checksum for each
                      of those. `-Dmaven.install.skip=true` does not stop it, a dedicated
                      -Dmaven.repo.local does not stop it, and the plugin exposes no file-level
                      filter: excludeArtifacts matches whole modules. That is why
                      scripts/publish-central.sh assembles the bundle itself from target/ and uploads
                      it through the same Portal API. See docs/publishing.md.

                      autoPublish=false and waitUntil=validated are the safe half of the same
                      decision: a version on Central cannot be withdrawn, so nothing here publishes
                      unless the publish script is given its release flag.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
